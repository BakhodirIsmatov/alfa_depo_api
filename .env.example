ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://alfateks:alfateks@db:5432/alfateks
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
# Allowed range: 5 minutes through 43200 minutes (30 days)
JWT_EXPIRE_MINUTES=60
JWT_ISSUER=alfateks-api
JWT_AUDIENCE=alfateks-clients
ACTIVITY_UPDATE_MINUTES=5
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_MINUTES=15
AUDIT_MAX_PAGE_SIZE=100
AUDIT_MAX_RANGE_DAYS=366
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOW_NEGATIVE_STOCK=false
MEDIA_ROOT=media
MAX_PRODUCT_IMAGE_BYTES=5242880
MAX_PRODUCT_IMAGE_PIXELS=24000000
PRODUCT_IMAGE_MAX_DIMENSION=2000
OCR_LANGUAGES=eng+tur+rus+uzb
OCR_TIMEOUT_SECONDS=20
REPORT_TIMEZONE=Europe/Istanbul
REPORT_MAX_EXPORT_ROWS=5000
REPORT_PNG_MAX_ROWS=200

POSTGRES_DB=alfateks
POSTGRES_USER=alfateks
POSTGRES_PASSWORD=replace-with-a-strong-database-password

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_FULL_NAME=Warehouse Administrator
SEED_ADMIN_PASSWORD=replace-with-a-strong-admin-password
